[Unit]
Description=Price API
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/price-api
EnvironmentFile=/opt/price-api/.env
ExecStart=/opt/price-api/.venv/bin/uvicorn price_api.app.main:app --host 127.0.0.1 --port 8000
# If API_KEY_AUTH_ENABLED=true, ensure external health/readiness checks send
# Authorization: Bearer <api-key> for /v1/* endpoints.
Restart=always
RestartSec=3
User=www-data
Group=www-data
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
