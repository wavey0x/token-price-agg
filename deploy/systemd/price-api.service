[Unit]
Description=Prices API
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/wavey/price-api
EnvironmentFile=/home/wavey/price-api/.env
ExecStart=/home/wavey/price-api/venv/bin/python -m uvicorn price_api.app.main:app --host 127.0.0.1 --port 18743
# If API_KEY_AUTH_ENABLED=true, ensure external health/readiness checks send
# Authorization: Bearer <api-key> for /v1/* endpoints.
Restart=always
RestartSec=3
User=wavey
Group=wavey
SupplementaryGroups=tokenagg
UMask=0002
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
