# Keep secrets and host-specific overrides here.
# Non-secret defaults should live in `config/app.toml`.

# Optional provider API keys.
LIFI_API_KEY=
ENSO_API_KEY=

# Optional overrides (only set when you need to override TOML/defaults).
# APP_ENV=dev
# APP_VERSION=0.1.0
# PRICE_API_CONFIG_FILE=/opt/price-api/config/app.toml
# LIFI_DENY_EXCHANGES=fly
# Chain-specific private endpoints (no cross-chain fallback).
# Required for use_underlying=true; optional for provider quotes.
ETHEREUM_RPC_URL=
OPTIMISM_RPC_URL=
GNOSIS_RPC_URL=
POLYGON_RPC_URL=
ARBITRUM_RPC_URL=
AVALANCHE_RPC_URL=
# API_KEY_AUTH_ENABLED=true
# API_KEY_UNAUTH_ACCESS_ENABLED=true
# API_KEY_UNAUTH_MIN_INTERVAL_SECONDS=1
